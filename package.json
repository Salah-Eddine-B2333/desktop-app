{
  "name": "station-project",
  "private": true,
  "productName": "Station",
  "version": "3.3.0-b1",
  "description": "Station",
  "homepage": "https://getstation.com",
  "author": "Bouazza Salah eddine <Bouazza_Salah_Eddine2333@protonmail.com> (https://github.com/Salah-Eddine-B2333)",
  "contributors": [],
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "clean": "yarn workspaces foreach --all run clean && rimraf release",
    "release": "yarn clean && yarn workspaces foreach --all --topological run release",
    "dev": "yarn workspaces foreach --all --topological run dev",
    "lint": "yarn workspaces foreach --all --topological run lint",
    "test": "yarn workspaces foreach --all run test"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "electron": "node_modules/.bin/electron"
  },
  "devDependencies": {
    "rimraf": "^5.0.10"
  },
  "engines": {
    "node": ">=22.22.0",
    "yarn": ">=4.1.0"
  },
  "volta": {
    "node": "22.22.0",
    "yarn": "4.1.0"
  },
  "packageManager": "yarn@4.1.0",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salah-Eddine-B2333/desktop-app.git"
  },
  "bugs": {
    "url": "https://github.com/Salah-Eddine-B2333/desktop-app/issues"
  },
  "keywords": [],
  "dependencies": {
    "update-electron-app": "^3.1.2"
  }
